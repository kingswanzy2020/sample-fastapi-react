# Copy this file to .env and fill in real values. .env is gitignored and
# read automatically by docker-compose via each service's env_file.
#
# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=postgres

# ---- Backend ----
# Must be a fully-resolved literal: docker-compose's env_file loading does
# not expand ${...} references to other vars within this file.
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
SECRET_KEY=                   # generate: openssl rand -hex 32
CELERY_BROKER_URL=redis://redis:6379/0
DEBUG=false
