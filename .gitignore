.env
.docker/
__pycache__/
*.pyc
.pytest_cache/
frontend/node_modules/
frontend/build/

# --- terraform -------------------------------------------------------------
# State holds every resource attribute in plaintext, including anything
# sensitive. It must never be committed.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# Saved plans can contain variable values.
*.tfplan
tfplan

# Backend config embeds the AWS account ID. backend.hcl.example is committed.
backend.hcl

# environments/*/terraform.tfvars IS committed on purpose -- it holds
# environment configuration and no secrets. These patterns catch the ad-hoc
# override files that tend to accumulate real values.
*.auto.tfvars
secrets.tfvars
*-secrets.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- ansible ---------------------------------------------------------------
# Vault password. Nothing that can decrypt a vaulted value belongs in git.
ansible/.vault-pass
ansible/vault-password*

# Encrypted variable files are safe to commit in principle, but committing
# ciphertext plus a widely-distributed password is not. vault.yml.example is
# committed and shows the shape.
ansible/inventory/group_vars/**/vault.yml

# Generated from `terraform output` by playbooks/sync-terraform.yml. Carries the
# AWS account ID in an ARN, same reasoning as terraform's backend.hcl.
# terraform.yml.example is committed.
ansible/inventory/group_vars/**/terraform.yml

# Static inventory with a real address. hosts.example.yml is committed.
ansible/inventory/hosts.yml

# Collections installed with `ansible-galaxy collection install -r requirements.yml -p ./.collections`
ansible/.collections/
ansible/*.retry
