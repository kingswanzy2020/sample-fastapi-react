#!/usr/bin/env bash
#
# /usr/local/bin/app-deploy
#
# Rendered by Terraform at instance creation, then owned by the box. Run it to
# deploy or re-deploy the application:
#
#   sudo app-deploy              # use the tag recorded in IMAGE_TAG
#   sudo app-deploy a1b2c3d      # deploy a specific tag and record it
#
# It is idempotent: safe to run repeatedly, and it is what the systemd unit
# calls on boot -- so a reboot re-reads secrets, which is how a rotated
# credential reaches the application.
#
# This script is the seam where Terraform's job ends. Anything more elaborate
# (config templating, orchestration, multi-host) belongs in Ansible or CI.

set -euo pipefail

REGION="${aws_region}"
APP_DIR="${app_directory}"
APP_SECRET_ARN="${app_secret_arn}"
DB_SECRET_ARN="${db_secret_arn}"
REGISTRY_PREFIX="${registry_prefix}"
USE_RDS="${use_rds}"
DB_HOST="${db_host}"
DB_PORT="${db_port}"
DB_NAME="${db_name}"
DB_USER="${db_user}"

log()  { printf '[deploy] %s\n' "$*"; }
die()  { printf '[deploy] ERROR: %s\n' "$*" >&2; exit 1; }

cd "$${APP_DIR}" || die "$${APP_DIR} does not exist. Put the application there first."

[[ -f docker-compose.yml ]] \
  || die "no docker-compose.yml in $${APP_DIR}. The application has not been placed on this instance yet."

# ---------------------------------------------------------------------------
# Image tag
#
# Recorded in a file so a redeploy does not need Terraform, and so the systemd
# unit knows what to start on boot.
# ---------------------------------------------------------------------------

TAG="$${1:-}"
if [[ -z "$${TAG}" ]]; then
  TAG="$(cat "$${APP_DIR}/IMAGE_TAG" 2>/dev/null || echo latest)"
fi
printf '%s\n' "$${TAG}" > "$${APP_DIR}/IMAGE_TAG"
log "deploying tag: $${TAG}"

# ---------------------------------------------------------------------------
# Secrets
#
# Fetched at deploy time, never stored anywhere but the .env file this script
# writes. Failures here are fatal on purpose: starting the application with a
# missing SECRET_KEY would sign every JWT with an empty string.
# ---------------------------------------------------------------------------

log "reading application secret"
APP_JSON="$(aws secretsmanager get-secret-value \
  --secret-id "$${APP_SECRET_ARN}" \
  --region "$${REGION}" \
  --query SecretString --output text 2>/dev/null || true)"

if [[ -z "$${APP_JSON}" ]]; then
  die "could not read $${APP_SECRET_ARN}.

  The secret exists but has no value yet. Terraform creates the container and
  deliberately never writes the value, so the secret cannot leak through
  Terraform state. Set it once, from your workstation:

    aws secretsmanager put-secret-value \\
      --secret-id $${APP_SECRET_ARN} \\
      --region $${REGION} \\
      --secret-string \"{\\\"SECRET_KEY\\\":\\\"\$(openssl rand -hex 32)\\\",\\\"POSTGRES_PASSWORD\\\":\\\"\$(openssl rand -base64 32 | tr -d '/+=')\\\"}\"
"
fi

SECRET_KEY="$(jq -r '.SECRET_KEY // empty' <<<"$${APP_JSON}")"
[[ -n "$${SECRET_KEY}" ]] || die "SECRET_KEY missing from $${APP_SECRET_ARN}"
[[ "$${SECRET_KEY}" != "change_this" ]] || die "SECRET_KEY is still the placeholder 'change_this'. Generate a real one."

# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------

if [[ "$${USE_RDS}" == "true" ]]; then
  log "reading RDS master password"
  DB_JSON="$(aws secretsmanager get-secret-value \
    --secret-id "$${DB_SECRET_ARN}" \
    --region "$${REGION}" \
    --query SecretString --output text)" \
    || die "could not read the RDS secret $${DB_SECRET_ARN}"

  DB_PASSWORD="$(jq -r '.password' <<<"$${DB_JSON}")"
  [[ -n "$${DB_PASSWORD}" && "$${DB_PASSWORD}" != "null" ]] || die "no password in the RDS secret"

  DATABASE_URL="postgresql://$${DB_USER}:$${DB_PASSWORD}@$${DB_HOST}:$${DB_PORT}/$${DB_NAME}"
else
  # No RDS: the Postgres container from docker-compose.yml is used, and its
  # password comes from the same application secret.
  DB_PASSWORD="$(jq -r '.POSTGRES_PASSWORD // empty' <<<"$${APP_JSON}")"
  [[ -n "$${DB_PASSWORD}" ]] || die "POSTGRES_PASSWORD missing from $${APP_SECRET_ARN} (required when RDS is disabled)"

  DATABASE_URL="postgresql://$${DB_USER}:$${DB_PASSWORD}@postgres:5432/$${DB_NAME}"
fi

# ---------------------------------------------------------------------------
# .env
#
# Written with umask 077 so it is readable only by root. Every value here came
# from Secrets Manager seconds ago; none of it is in git or in Terraform state.
# ---------------------------------------------------------------------------

log "writing $${APP_DIR}/.env"
(
  umask 077
  cat > "$${APP_DIR}/.env" <<ENVFILE
# Generated by app-deploy at $(date -Is). Do not edit; do not commit.
REGISTRY=$${REGISTRY_PREFIX}
IMAGE_TAG=$${TAG}

POSTGRES_USER=$${DB_USER}
POSTGRES_PASSWORD=$${DB_PASSWORD}
POSTGRES_DB=$${DB_NAME}

DATABASE_URL=$${DATABASE_URL}
SECRET_KEY=$${SECRET_KEY}
CELERY_BROKER_URL=redis://redis:6379/0
DEBUG=false
ENVFILE
)
chmod 600 "$${APP_DIR}/.env"

# ---------------------------------------------------------------------------
# Compose file selection
# ---------------------------------------------------------------------------

COMPOSE_FILES=(-f docker-compose.yml -f docker-compose.prod.yml)

if [[ "$${USE_RDS}" == "true" ]]; then
  # The base compose file runs Postgres in a container and makes backend and
  # migrate wait for it. With RDS that container should not exist at all, so
  # this overlay removes the service and the two dependencies on it.
  #
  # `!reset null` requires Docker Compose v2.24 or newer.
  log "generating RDS overlay"
  cat > "$${APP_DIR}/docker-compose.aws.yml" <<'OVERLAY'
# Generated by app-deploy. Applied only when RDS is in use.
services:
  postgres: !reset null

  backend:
    depends_on:
      postgres: !reset null

  migrate:
    depends_on:
      postgres: !reset null
OVERLAY
  COMPOSE_FILES+=(-f docker-compose.aws.yml)
else
  rm -f "$${APP_DIR}/docker-compose.aws.yml"
fi

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------

log "authenticating to ECR"
aws ecr get-login-password --region "$${REGION}" \
  | docker login --username AWS --password-stdin "$${REGISTRY_PREFIX%%/*}"

log "validating merged compose configuration"
docker compose "$${COMPOSE_FILES[@]}" config --quiet \
  || die "compose configuration is invalid -- check the overlay and your Compose version (need >= 2.24 for !reset)"

log "pulling images"
docker compose "$${COMPOSE_FILES[@]}" pull --quiet

log "starting services"
docker compose "$${COMPOSE_FILES[@]}" up -d --remove-orphans

log "pruning old images"
docker image prune -af --filter "until=168h" >/dev/null 2>&1 || true

log "deployed tag $${TAG}"
docker compose "$${COMPOSE_FILES[@]}" ps
