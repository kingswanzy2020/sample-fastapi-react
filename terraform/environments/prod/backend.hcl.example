# Copy to backend.hcl and fill in your account ID, then:
#   terraform init -backend-config=backend.hcl
#
# Or generate it directly from the bootstrap configuration:
#   cd ../../bootstrap
#   terraform output -raw prod_backend_config > ../environments/prod/backend.hcl
#
# backend.hcl is gitignored because the bucket name embeds the AWS account ID.

bucket = "tfstate-fastapi-react-<ACCOUNT_ID>"
key    = "prod/terraform.tfstate"
region = "us-east-1"

encrypt = true

# S3-native state locking via conditional writes. Requires Terraform >= 1.10.
use_lockfile = true
