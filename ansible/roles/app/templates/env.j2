# {{ ansible_managed }}
#
# Rendered from AWS Secrets Manager at every run. Do not edit on the box: the
# next play overwrites it. Do not copy it anywhere -- every value below is live.
#
# Deliberately carries no timestamp, unlike the file /usr/local/bin/app-deploy
# writes. A generated timestamp would make this file differ on every run, and
# "changed=0 on a second run" is the property that proves the play converges.
REGISTRY={{ app_registry_prefix }}
IMAGE_TAG={{ app_image_tag }}

POSTGRES_USER={{ db_user }}
{# Escape '$' as '$$': Docker Compose's own .env interpolation treats a bare
   '$' as the start of a variable reference (used for ${POSTGRES_PASSWORD} in
   docker-compose.yml) and silently blanks out anything it doesn't recognize.
   The RDS generator does not exclude '$', so this bites in practice. #}
POSTGRES_PASSWORD={{ app_db_password | replace('$', '$$') }}
POSTGRES_DB={{ db_name }}

{# Percent-encode the password: it is generated by AWS and can contain
   characters that are structural inside a URL. app-deploy interpolates it raw,
   which works only because the RDS generator happens to exclude '/', '@' and
   '"'. Jinja's urlencode treats '/' as safe -- true for a path, wrong for the
   userinfo half of a URL -- so it is encoded explicitly. #}
{% if app_use_rds %}
DATABASE_URL=postgresql://{{ db_user }}:{{ app_db_password | urlencode | replace('/', '%2F') }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
{% else %}
DATABASE_URL=postgresql://{{ db_user }}:{{ app_db_password | urlencode | replace('/', '%2F') }}@postgres:5432/{{ db_name }}
{% endif %}
SECRET_KEY={{ app_env_secret_key }}
CELERY_BROKER_URL={{ app_celery_broker_url }}
DEBUG={{ app_debug | string | lower }}
